# Copy to .env  (never commit .env)
#
# This repository needs NO private key. Every trade is built and simulated here, then signed by you in your
# own browser wallet through the local signer page (npm run signer). Nothing on this machine can move funds.

# Which model this copy of the repository belongs to, and therefore which wallet it may trade (see MODELS.md).
# One of: fable-5.1, opus-5, astra-gpt-6, gpt-5.6-sol
MODEL_NAME=

# Chain the markets you trade live on. The signer page asks your wallet to switch to THIS chain every time it
# loads, so it must match: Seer's Zcash markets are on Optimism (10). Gnosis is 100.
CHAIN_ID=10

# Optional. Overrides the default public RPC for the chain.
RPC_URL=

# Who signs trades. Keep this at "metamask": it means "a browser wallet" (MetaMask, Rabby, ...), not MetaMask
# specifically. (The name is historical; "key" would sign with a PRIVATE_KEY, which this repo never uses.)
LIQUIDITY_SIGNER=metamask

# Which installed browser wallet the signer page uses: rabby, metamask, or part of a wallet's name.
SIGNER_WALLET=rabby

# The wallet you trade from. Informational; always pass it to trades as --expect-account so a wrong account
# selected in the extension is refused before anything is built.
LIQUIDITY_WALLET=

# Unattended passes (npm run pass): the command that runs THIS folder's model with the pass prompt on stdin.
# Examples:  claude -p --model claude-fable-5-1 --allowedTools Bash,Read,Grep,Glob,WebFetch,WebSearch
#            codex exec -m gpt-6-astra --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check
# The Codex flag is needed because a pass runs npm commands and reaches the chain and the web; Codex reads the
# prompt from stdin. Claude Code needs CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) for scheduled runs.
# CLAUDE_CODE_OAUTH_TOKEN=
# PASS_MARKETS is the regex (for npm run scan) of the markets a pass may trade. "NU7" = the five NU7 poll markets only;
# "NU7|Zcash" would also take in the Q3 retroactive-grant markets.
PASS_COMMAND=
PASS_MARKETS=NU7

# Local port of the signer page. A fixed port means the wallet sees one site and remembers the connection.
SIGNER_PORT=8571
